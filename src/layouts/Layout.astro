---
import '@fontsource/chiron-goround-tc';
import '@fontsource/fira-code';
import '../styles/global.css'
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CodeIcon from "../components/icons/Code.astro";
import BackgroundFx from '../components/BackgroundFx.astro';
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio de Tavo - Desarrollador y Programador Web</title>
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
	</head>
	<body>
		<BackgroundFx />
		<Header />
		<slot />
		<Footer />
		<script>
			const initCardGlow = () => {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				document.querySelectorAll<HTMLElement>('.glow-border, .project-card').forEach((card) => {
					card.addEventListener('pointermove', (event) => {
						const rect = card.getBoundingClientRect();
						card.style.setProperty('--hover-x', `${event.clientX - rect.left}px`);
						card.style.setProperty('--hover-y', `${event.clientY - rect.top}px`);
					});
				});
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initCardGlow, { once: true });
			} else {
				initCardGlow();
			}
		</script>
	</body>
</html>

<style is:global>
	:root{
		color-scheme: light dark;
	}

	html{
		font-family: 'Chiron GoRound TC', sans-serif;
		scroll-behavior: smooth;
	}

	body{
		background: #0a0518;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		isolation: isolate;
	}
	@media (prefers-reduced-motion: reduce) {
		body {
			scroll-behavior: auto;
		}
	}
</style>
