---
import data from '../data/github.json';

type Day = { iso: string; date: Date; count: number; level: number; col: number; row: number };
type MonthLabel = { x: number; label: string };
type RawDay = { date: string; count: number; level: number };

const CELL = 11;
const GAP = 2;
const PITCH = CELL + GAP;
const COLUMNS = 53;

const COLORS = ['rgba(255, 255, 255, 0.06)', '#3b2f6e', '#5b47ad', '#7f6bff', '#c6b6ff'];
const LEVEL_MAP: Record<string, number> = {
  NONE: 0,
  FIRST_QUARTILE: 1,
  SECOND_QUARTILE: 2,
  THIRD_QUARTILE: 3,
  FOURTH_QUARTILE: 4,
};

let total: string | null = null;
let generatedAt: string | null = null;
let days: Day[] = [];
let labels: MonthLabel[] = [];
let loaded = false;
let notice: string | null = null;

const buildDays = (raw: RawDay[]) => {
  const fromMs = new Date(`${raw[0].date}T00:00:00Z`).getTime();
  const DAY = 86400000;
  let lastMonth = -1;
  for (const d of raw) {
    const date = new Date(`${d.date}T00:00:00Z`);
    const diff = Math.round((date.getTime() - fromMs) / DAY);
    const col = Math.floor(diff / 7);
    const row = diff % 7;
    days.push({ iso: d.date, date, count: d.count, level: d.level, col, row });
    const month = date.getUTCMonth();
    if (month !== lastMonth) {
      labels.push({ x: col * PITCH, label: date.toLocaleDateString('es', { month: 'short', timeZone: 'UTC' }) });
      lastMonth = month;
    }
  }
};

const jsonData = data as { total?: number; generatedAt?: string; days?: RawDay[] };
if (jsonData?.days && jsonData.days.length > 0) {
  total = String(jsonData.total ?? '');
  generatedAt = jsonData.generatedAt ?? null;
  buildDays(jsonData.days);
  loaded = true;
} else if (import.meta.env.GITHUB_TOKEN) {
  try {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 8000);
    const res = await fetch('https://api.github.com/graphql', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${import.meta.env.GITHUB_TOKEN}`,
        'Content-Type': 'application/json',
        'User-Agent': 'portfolio',
      },
      body: JSON.stringify({
        query: `query($login:String!){user(login:$login){contributionsCollection{contributionCalendar{totalContributions weeks{contributionDays{date contributionCount contributionLevel}}}}}}`,
        variables: { login: 'tavoidkk' },
      }),
      signal: controller.signal,
    });
    clearTimeout(timer);
    const json = await res.json();
    const cal = json?.data?.user?.contributionsCollection?.contributionCalendar;
    if (cal?.weeks) {
      const flat = cal.weeks.flatMap((w: { contributionDays: { date: string; contributionCount: number; contributionLevel: string }[] }) =>
        w.contributionDays.map((d) => ({
          date: d.date,
          count: d.contributionCount,
          level: LEVEL_MAP[d.contributionLevel] ?? 0,
        }))
      );
      if (flat.length) {
        total = String(cal.totalContributions);
        buildDays(flat);
        loaded = true;
      }
    }
  } catch {
    loaded = false;
  }
  if (!loaded) notice = 'No se pudo cargar el heatmap desde la API.';
} else {
  notice = 'Faltan los datos locales: ejecuta `node scripts/refresh-contributions.mjs`.';
}

const width = COLUMNS * PITCH - GAP;
const gridHeight = 7 * PITCH - GAP;
const LABEL_H = 12;
const LEGEND_H = 14;
const svgHeight = LABEL_H + gridHeight + LEGEND_H;

const formatTooltip = (iso: string, count: number) => {
  const date = new Date(`${iso}T00:00:00Z`).toLocaleDateString('es', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
  if (count === 0) return `${date} · Sin contribuciones`;
  return `${count} ${count === 1 ? 'contribución' : 'contribuciones'} · ${date}`;
};

const formatUpdated = (iso: string) => {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return null;
  return `Actualizado el ${date.toLocaleDateString('es', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}`;
};
---

{
  loaded ? (
    <>
      <div class="github-heatmap-total">
        {total ? `${total} contribuciones en el último año` : 'Actividad de GitHub'}
      </div>
      <svg
        class="github-heatmap"
        viewBox={`0 0 ${width} ${svgHeight}`}
        role="img"
        aria-label="Gráfico de contribuciones de GitHub del último año"
      >
        <g class="gh-month">
          {labels.map(l => (
            <text key={l.x} x={l.x} y={9}>{l.label}</text>
          ))}
        </g>
        <g transform={`translate(0, ${LABEL_H})`}>
          {days.map(day => (
            <rect
              key={day.iso}
              x={day.col * PITCH}
              y={day.row * PITCH}
              width={CELL}
              height={CELL}
              rx={2}
              fill={COLORS[day.level]}
            >
              <title>{formatTooltip(day.iso, day.count)}</title>
            </rect>
          ))}
        </g>
      </svg>
      {notice && <p class="github-heatmap-notice">{notice}</p>}
      <div class="github-heatmap-legend">
        <span>Menos</span>
        {[1, 2, 3, 4].map(level => (
          <i key={level} style={`background: ${COLORS[level]}`}></i>
        ))}
        <span>Más</span>
      </div>
      {generatedAt && formatUpdated(generatedAt) && (
        <p class="github-heatmap-updated">{formatUpdated(generatedAt)}</p>
      )}
    </>
  ) : (
    <p class="github-heatmap-error">No se pudo cargar el gráfico de contribuciones.</p>
  )
}

<style>
  .github-heatmap {
    width: 100%;
    height: auto;
    display: block;
  }

  .github-heatmap-total {
    font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    color: rgba(214, 226, 255, 0.6);
    text-align: right;
    margin-bottom: 10px;
  }

  .github-heatmap-notice {
    font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    color: rgba(214, 226, 255, 0.45);
    text-align: right;
    margin: 6px 0 0;
  }

  .github-heatmap-updated {
    font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    color: rgba(214, 226, 255, 0.4);
    text-align: right;
    margin: 4px 0 0;
  }

  .github-heatmap-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    margin-top: 8px;
    font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    color: rgba(214, 226, 255, 0.5);
  }

  .github-heatmap-legend i {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    display: inline-block;
  }

  .github-heatmap-error {
    font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    color: rgba(214, 226, 255, 0.5);
    text-align: center;
    padding: 24px 0;
    margin: 0;
  }

  .gh-month text {
    font-size: 8px;
    fill: rgba(214, 226, 255, 0.45);
    font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
</style>