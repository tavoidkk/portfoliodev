---
import { projects } from './projects.js';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects-terminal" class="projects-terminal terminal-shell stagger-item" data-project-terminal>
  <div class="terminal-bar">
    <span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="projects-terminal-title">tavoidkk@portfolio:~/projects$ ./grid --interactive</span>
    <span class="projects-terminal-status">{String(projects.length).padStart(2, '0')} OK</span>
  </div>

  <div class="projects-body">
    <div class="terminal-prompt projects-prompt" aria-hidden="true">
      <span class="terminal-prompt-path">tavoidkk@portfolio</span><span class="terminal-prompt-sep">:~$</span>
      <span class="terminal-prompt-cmd" data-project-cmd data-text="proyectos --grid">proyectos --grid</span>
      <span class="terminal-cursor"></span>
    </div>

    <div class="projects-meta" aria-hidden="true">
      <span>&gt; proyectos.listado()</span>
      <span>{String(projects.length).padStart(2, '0')} módulos cargados</span>
    </div>

    <div class="projects-grid">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i + 1} featured={Boolean(project.featured)} />
      ))}
    </div>

    <p class="projects-hint" aria-hidden="true">click / Enter expandir · Escape cerrar</p>
  </div>
</section>

<script>
  const initProjectsTerminal = () => {
    const terminal = document.querySelector<HTMLElement>('[data-project-terminal]');
    if (!terminal) return;

    const cards = Array.from(terminal.querySelectorAll<HTMLElement>('[data-project-card]'));
    const command = terminal.querySelector<HTMLElement>('[data-project-cmd]');
    if (!cards.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const doc = document as Document & {
      startViewTransition?: (callback: () => void) => { finished: Promise<void> };
    };
    let openCard: HTMLElement | null = null;
    let animating = false;

    const setExpanded = (card: HTMLElement, expanded: boolean) => {
      const button = card.querySelector<HTMLButtonElement>('[data-project-more]');
      const details = card.querySelector<HTMLElement>('[data-project-details]');
      const label = button?.querySelector<HTMLElement>('[data-more-label]');
      const mark = button?.querySelector<HTMLElement>('[data-more-mark]');

      card.classList.toggle('is-expanded', expanded);
      button?.setAttribute('aria-expanded', String(expanded));
      if (label) label.textContent = expanded ? 'contraer' : 'expandir';
      if (mark) mark.textContent = expanded ? '[-]' : '[+]';
      if (details) {
        details.setAttribute('aria-hidden', String(!expanded));
        details.inert = !expanded;
      }
    };

    const dimSiblings = (active: HTMLElement | null) => {
      cards.forEach((card) => card.toggleAttribute('data-dimmed', Boolean(active) && card !== active));
    };

    const morph = (card: HTMLElement, mutate: () => void, after?: () => void) => {
      if (animating) return;
      animating = true;
      card.style.setProperty('view-transition-name', 'project-card-morph');

      let settled = false;
      const done = () => {
        if (settled) return;
        settled = true;
        card.style.removeProperty('view-transition-name');
        animating = false;
        after?.();
      };

      if (!doc.startViewTransition || reduceMotion) {
        mutate();
        done();
        return;
      }

      const transition = doc.startViewTransition(mutate);
      transition.finished.finally(done);
      window.setTimeout(done, 800);
    };

    const open = (card: HTMLElement) => {
      if (openCard === card) return;
      morph(
        card,
        () => {
          if (openCard) setExpanded(openCard, false);
          openCard = card;
          setExpanded(card, true);
          dimSiblings(card);
        },
        () => {
          card.scrollIntoView({ block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
        },
      );
    };

    const close = (card: HTMLElement) => {
      if (openCard !== card) return;
      const hadFocus = card.contains(document.activeElement);
      morph(
        card,
        () => {
          setExpanded(card, false);
          openCard = null;
          dimSiblings(null);
        },
        () => {
          if (hadFocus) {
            card.querySelector<HTMLButtonElement>('[data-project-more]')?.focus({ preventScroll: true });
          }
        },
      );
    };

    cards.forEach((card) => {
      card.addEventListener('click', (event) => {
        const target = event.target as Element;
        if (target.closest('a')) return;
        if (card.classList.contains('is-expanded')) close(card);
        else open(card);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && openCard) close(openCard);
    });

    const boot = () => {
      if (terminal.dataset.booted) return;
      terminal.dataset.booted = 'true';
      terminal.classList.add('is-booted');

      if (reduceMotion || !command) {
        terminal.classList.add('is-ready');
        return;
      }

      const text = command.dataset.text ?? command.textContent ?? '';
      command.textContent = '';
      let index = 0;

      const type = () => {
        command.textContent = text.slice(0, index + 1);
        index += 1;
        if (index < text.length) window.setTimeout(type, 28);
        else terminal.classList.add('is-ready');
      };

      window.setTimeout(type, 200);
    };

    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        boot();
        observer.disconnect();
      }
    }, { threshold: 0.2 });

    observer.observe(terminal);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectsTerminal, { once: true });
  } else {
    initProjectsTerminal();
  }
</script>

<style>
  .projects-terminal { font-family: 'Fira Code', ui-monospace, monospace; }

  .projects-terminal.is-booted { animation: projects-boot 460ms steps(2, end) both; }

  .projects-terminal-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .projects-terminal-status {
    margin-left: auto;
    color: var(--term-green);
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .projects-body { padding: 0.85rem; }

  .projects-prompt { margin-bottom: 0.75rem; }

  .projects-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.8rem;
    color: rgba(214, 226, 255, 0.42);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  .projects-hint {
    margin-top: 0.75rem;
    color: rgba(214, 226, 255, 0.3);
    font-size: 0.52rem;
    letter-spacing: 0.05em;
  }

  @media (min-width: 640px) {
    .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @keyframes projects-boot {
    0% { opacity: 0.35; filter: brightness(1.5); }
    40% { opacity: 1; filter: brightness(0.92); }
    70% { opacity: 0.75; filter: brightness(1.2); }
    100% { opacity: 1; filter: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-terminal.is-booted { animation: none; }
  }
</style>

<style is:global>
  ::view-transition-group(project-card-morph) {
    animation-duration: 420ms;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0s;
  }
</style>
