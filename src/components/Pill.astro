---
const { class: className = '', ...props } = Astro.props;
---

<a
{...props}
    target="_blank" 
    rel="noopener noreferrer"
    class:list={[
      'min-h-8 rounded-full border border-white/10 flex justify-center items-center gap-x-1.5 px-2.5 pb-1 bg-white/3 hover:-translate-y-0.5 hover:bg-white/10 hover:border-cyan-300/25 transition duration-300 text-[11px] sm:text-xs md:px-3 md:text-sm whitespace-nowrap',
      className,
    ]}
>
    <slot />
</a>
