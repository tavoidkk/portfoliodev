---
import * as Icons from './icons/index.js';

interface Project {
  title: string;
  description: string;
  href: string;
  preview: string;
  tags: string[];
  image: string;
  status: string;
  accent: string;
  slug: string;
  year: string;
  role: string;
  highlights: string[];
  featured?: boolean;
}

interface Props {
  project: Project;
  index: number;
  featured?: boolean;
}

const { project, index, featured = false } = Astro.props;

const TAG_ICONS: Record<string, any> = {
  NextJS: Icons.NextJSIcon, Astro: Icons.AstroIcon, GitHub: Icons.GitHubIcon,
  Python: Icons.PythonIcon, JavaScript: Icons.JavaScriptIcon, React: Icons.ReactIcon,
  NodeJS: Icons.NodeJSIcon, ExpressJS: Icons.ExpressJSIcon, MySQL: Icons.MySQLIcon,
  TypeScript: Icons.TypeScriptIcon, PostgreSQL: Icons.PostgreSQLIcon, Supabase: Icons.SupabaseIcon,
};

const detailsId = `project-details-${index}`;
const titleId = `project-title-${index}`;
const delay = featured ? 60 : 120 + (index - 2) * 70;
const visualHref = project.preview || project.href;
---

<article
  class:list={['project-card', 'stagger-item', featured ? 'project-featured' : 'project-compact']}
  style={`--project-accent:${project.accent}; transition-delay:${delay}ms;`}
  data-project-card
  aria-labelledby={titleId}
>
  {featured && (
    <div class="project-chrome" aria-hidden="true">
      <span class="project-chrome-dots"><i></i><i></i><i></i></span>
      <span class="project-chrome-path">~/projects/{project.slug}</span>
      <span class="project-chrome-live">● LIVE</span>
    </div>
  )}

  <a
    class="project-visual"
    href={visualHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Abrir ${project.title}`}
    tabindex={-1}
  >
    <img src={project.image} alt={`Vista previa de ${project.title}`} loading={featured ? 'eager' : 'lazy'} />
    <span class="project-image-shade"></span>
    <span class="project-index">{String(index).padStart(2, '0')}</span>
    {featured && (
      <span class="project-featured-label"><span class="project-live-dot"></span>Proyecto destacado</span>
    )}
    <span class="project-open-icon" aria-hidden="true">↗</span>
  </a>

  <div class="project-content">
    <div class="project-summary">
      <p class="project-status">&gt; {project.status}</p>
      <h3 id={titleId}>{project.title}</h3>
      <p class="project-copy">{project.description}</p>
      <button
        class="project-more"
        type="button"
        data-project-more
        aria-expanded="false"
        aria-controls={detailsId}
      >
        <span data-more-label>Ver más</span>
        <svg class="project-more-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </button>
    </div>

    <div class="project-footer">
      <div class="project-tags" aria-label="Tecnologías utilizadas">
        {project.tags.map((tag) => {
          const Icon = TAG_ICONS[tag];
          return <span class="project-tag">{Icon && <Icon class="size-3.5" />}{tag}</span>;
        })}
      </div>
      <div class="project-icon-actions">
        {project.preview && (
          <a href={project.preview} target="_blank" rel="noopener noreferrer" aria-label={`Ver ${project.title}`}>
            <Icons.EyeIcon />
          </a>
        )}
        {project.href && (
          <a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Código de ${project.title}`}>
            <Icons.GitHubIcon class="size-5" />
          </a>
        )}
      </div>
    </div>

    <div class="project-details" id={detailsId} data-project-details aria-hidden="true" inert>
      <div class="project-details-inner">
        <p class="project-details-kicker">&gt; project.highlights()</p>
        <ul class="project-highlights">
          {project.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
        <dl class="project-meta">
          <div><dt>año</dt><dd>{project.year}</dd></div>
          <div><dt>rol</dt><dd>{project.role}</dd></div>
        </dl>
        <div class="project-actions">
          {project.preview && (
            <a class="project-action project-action-primary" href={project.preview} target="_blank" rel="noopener noreferrer">
              <Icons.EyeIcon />Ver proyecto
            </a>
          )}
          {project.href && (
            <a class="project-action project-action-secondary" href={project.href} target="_blank" rel="noopener noreferrer">
              <Icons.GitHubIcon class="size-5" />GitHub
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--project-accent) 22%, rgba(255, 255, 255, 0.08));
    border-radius: 1rem;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--project-accent) 8%, transparent), transparent 55%),
      linear-gradient(155deg, rgba(12, 18, 38, 0.94), rgba(5, 9, 22, 0.9));
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.32);
    transition:
      transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 420ms ease,
      box-shadow 420ms ease,
      opacity 320ms ease,
      filter 320ms ease;
  }

  .project-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in oklab, var(--project-accent) 58%, transparent);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.42),
      0 0 30px color-mix(in oklab, var(--project-accent) 14%, transparent);
  }

  /* Anillo de gradiente */
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--project-accent) 55%, transparent),
      transparent 38%,
      rgba(124, 249, 255, 0.22) 78%,
      transparent
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.55;
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .project-card:hover::before,
  .project-card.is-expanded::before {
    opacity: 1;
  }

  /* Card atenuada mientras otra está abierta */
  .project-card[data-dimmed] {
    opacity: 0.42;
    filter: saturate(0.7);
    transform: scale(0.985);
  }

  .project-card[data-dimmed]:hover {
    opacity: 0.6;
    transform: scale(0.995);
  }

  .project-card.is-expanded {
    grid-column: 1 / -1;
  }

  /* Chrome de terminal (solo destacado) */
  .project-chrome {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid rgba(124, 249, 255, 0.1);
    background: rgba(5, 9, 22, 0.72);
    color: rgba(214, 226, 255, 0.52);
    font: 500 0.58rem 'Fira Code', ui-monospace, monospace;
    letter-spacing: 0.04em;
  }

  .project-chrome-dots {
    display: flex;
    gap: 0.22rem;
  }

  .project-chrome-dots i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #ff5f57;
  }

  .project-chrome-dots i:nth-child(2) { background: #febc2e; }
  .project-chrome-dots i:nth-child(3) { background: #28c840; }

  .project-chrome-path { margin-left: 0.2rem; }

  .project-chrome-live {
    margin-left: auto;
    color: #34d399;
    letter-spacing: 0.1em;
  }

  /* Visual */
  .project-visual {
    position: relative;
    display: block;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
  }

  .project-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 500ms ease;
  }

  .project-card:hover .project-visual img {
    transform: scale(1.05);
    filter: saturate(1.08);
  }

  /* Barrido de luz + scanlines */
  .project-visual::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, 0.14) 50%, transparent 62%);
    transform: translateX(-130%);
    transition: transform 900ms ease;
    pointer-events: none;
  }

  .project-card:hover .project-visual::before {
    transform: translateX(130%);
  }

  .project-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 3px);
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .project-image-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(4, 8, 20, 0.08), rgba(4, 8, 20, 0.68));
  }

  .project-index {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    z-index: 3;
    color: rgba(255, 255, 255, 0.7);
    font: 600 0.68rem 'Fira Code', ui-monospace, monospace;
    letter-spacing: 0.18em;
  }

  .project-featured-label {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid color-mix(in oklab, var(--project-accent) 45%, transparent);
    border-radius: 999px;
    background: rgba(5, 9, 22, 0.78);
    backdrop-filter: blur(10px);
    color: #fff7bf;
    font: 600 0.6rem 'Fira Code', ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-live-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--project-accent);
    box-shadow: 0 0 10px var(--project-accent);
    animation: project-pulse 1.8s ease-in-out infinite;
  }

  .project-open-icon {
    position: absolute;
    right: 0.85rem;
    bottom: 0.75rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    background: rgba(5, 9, 22, 0.7);
    color: white;
    backdrop-filter: blur(8px);
    transition: transform 320ms ease, background 320ms ease, color 320ms ease;
  }

  .project-card:hover .project-open-icon {
    transform: rotate(45deg);
    background: var(--project-accent);
    color: #080b12;
  }

  .project-featured-label ~ .project-open-icon {
    display: none;
  }

  /* Contenido */
  .project-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    padding: 1rem;
  }

  .project-summary {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .project-status {
    margin-bottom: 0.35rem;
    color: var(--project-accent);
    font: 600 0.6rem 'Fira Code', ui-monospace, monospace;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .project-content h3 {
    color: #fff;
    font-size: 1.15rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .project-copy {
    margin-top: 0.45rem;
    color: rgba(214, 226, 255, 0.68);
    font-size: 0.75rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .project-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    margin-top: 0.5rem;
    color: var(--project-accent);
    font: 600 0.66rem 'Fira Code', ui-monospace, monospace;
    transition: color 200ms ease;
  }

  .project-more:hover { color: #fff; }

  .project-more:focus-visible {
    outline: 2px solid var(--project-accent);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .project-more-icon {
    width: 0.78rem;
    height: 0.78rem;
    transition: transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-more[aria-expanded='true'] .project-more-icon {
    transform: rotate(180deg);
  }

  .project-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.7rem;
    margin-top: auto;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.5rem;
    border: 1px solid color-mix(in oklab, var(--project-accent) 18%, rgba(255, 255, 255, 0.08));
    border-radius: 0.45rem;
    background: rgba(255, 255, 255, 0.035);
    color: rgba(230, 241, 255, 0.82);
    font: 500 0.58rem 'Fira Code', ui-monospace, monospace;
  }

  .project-tag :global(svg) { color: var(--project-accent); }

  .project-icon-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .project-icon-actions a {
    color: rgba(214, 226, 255, 0.55);
    transition: color 250ms ease, transform 250ms ease;
  }

  .project-icon-actions a:hover {
    color: var(--project-accent);
    transform: translateY(-2px);
  }

  /* Detalle expandido */
  .project-details {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 440ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 320ms ease;
  }

  .project-details-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .project-details-kicker {
    padding-top: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(214, 226, 255, 0.42);
    font: 500 0.58rem 'Fira Code', ui-monospace, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-highlights {
    display: grid;
    gap: 0.3rem;
  }

  .project-highlights li {
    position: relative;
    padding-left: 0.95rem;
    color: rgba(214, 226, 255, 0.75);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .project-highlights li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--project-accent);
    font-weight: 700;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
  }

  .project-meta div {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .project-meta dt {
    color: rgba(214, 226, 255, 0.4);
    font: 600 0.52rem 'Fira Code', ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-meta dd {
    color: #e6f1ff;
    font-size: 0.72rem;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .project-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.62rem 0.85rem;
    border-radius: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    transition: transform 250ms ease, background 250ms ease, border-color 250ms ease;
  }

  .project-action:hover { transform: translateY(-2px); }

  .project-action-primary {
    background: var(--project-accent);
    color: #090b12;
  }

  .project-action-secondary {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: #e6f1ff;
  }

  .project-action-secondary:hover {
    border-color: color-mix(in oklab, var(--project-accent) 40%, transparent);
  }

  /* Estados expandidos */
  .project-card.is-expanded .project-copy {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .project-card.is-expanded .project-details {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .project-card.is-expanded .project-icon-actions { display: none; }

  /* Layouts */
  .project-featured {
    display: grid;
    grid-template-columns: 1fr;
  }

  .project-featured .project-visual { height: 220px; }

  .project-featured .project-content { padding: 1.05rem; }

  .project-featured .project-content h3 {
    font-size: clamp(1.45rem, 4vw, 1.9rem);
  }

  .project-featured .project-copy { -webkit-line-clamp: 4; }

  .project-compact {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .project-compact .project-visual { height: 150px; }

  @media (min-width: 640px) {
    .project-featured {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }

    .project-featured .project-visual {
      height: 100%;
      min-height: 340px;
    }

    .project-featured.is-expanded {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .project-card.is-expanded {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: stretch;
    }

    .project-card.is-expanded .project-visual {
      height: 100%;
      min-height: 320px;
    }

    .project-card.is-expanded .project-content {
      padding: 1.1rem 1.15rem;
    }
  }

  @keyframes project-pulse {
    50% { opacity: 0.55; transform: scale(1.35); }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-visual img,
    .project-visual::before,
    .project-open-icon,
    .project-action,
    .project-details,
    .project-more-icon {
      transition: none !important;
    }

    .project-card:hover { transform: none; }
    .project-card:hover .project-visual img { transform: none; }
    .project-card:hover .project-visual::before { transform: translateX(-130%); }
    .project-live-dot { animation: none; }
    .project-card[data-dimmed],
    .project-card[data-dimmed]:hover { transform: none; }
  }
</style>
