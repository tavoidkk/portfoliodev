---
import * as Icons from './icons/index.js';

interface Project {
  title: string;
  description: string;
  href: string;
  preview: string;
  tags: string[];
  image: string;
  status: string;
  accent: string;
  slug: string;
  year: string;
  role: string;
  highlights: string[];
  featured?: boolean;
}

interface Props {
  project: Project;
  index: number;
  featured?: boolean;
}

const { project, index, featured = false } = Astro.props;

const TAG_ICONS: Record<string, any> = {
  NextJS: Icons.NextJSIcon, Astro: Icons.AstroIcon, GitHub: Icons.GitHubIcon,
  Python: Icons.PythonIcon, JavaScript: Icons.JavaScriptIcon, React: Icons.ReactIcon,
  NodeJS: Icons.NodeJSIcon, ExpressJS: Icons.ExpressJSIcon, MySQL: Icons.MySQLIcon,
  TypeScript: Icons.TypeScriptIcon, PostgreSQL: Icons.PostgreSQLIcon, Supabase: Icons.SupabaseIcon,
};

const detailsId = `project-details-${index}`;
const titleId = `project-title-${index}`;
const delay = 80 + index * 60;
---

<article
  class:list={['project-card', 'stagger-item', featured && 'pc-featured']}
  style={`--project-accent:${project.accent}; transition-delay:${delay}ms;`}
  data-project-card
  aria-labelledby={titleId}
>
  <div class="pc-top">
    <span class="pc-thumb" aria-hidden="true">
      <img src={project.image} alt="" loading={featured ? 'eager' : 'lazy'} />
    </span>
    <div class="pc-heading">
      <p class="pc-status">&gt; {project.status}</p>
      <h3 id={titleId}>{project.title}</h3>
      <p class="pc-path">~/projects/{project.slug}</p>
    </div>
    <span class="pc-index">{String(index).padStart(2, '0')}</span>
  </div>

  <p class="pc-desc">{project.description}</p>

  <div class="pc-tags" aria-label="Tecnologías utilizadas">
    {project.tags.map((tag) => {
      const Icon = TAG_ICONS[tag];
      return <span class="pc-tag">{Icon && <Icon class="size-3" />}{tag}</span>;
    })}
  </div>

  <button
    class="pc-more"
    type="button"
    data-project-more
    aria-expanded="false"
    aria-controls={detailsId}
  >
    <span data-more-mark aria-hidden="true">[+]</span>
    <span data-more-label>expandir</span>
  </button>

  <div class="pc-details" id={detailsId} data-project-details aria-hidden="true" inert>
    <div class="pc-details-inner">
      <p class="pc-kicker">&gt; project.highlights()</p>
      <ul class="pc-highlights">
        {project.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
      <dl class="pc-meta">
        <div><dt>año</dt><dd>{project.year}</dd></div>
        <div><dt>rol</dt><dd>{project.role}</dd></div>
      </dl>
      <div class="pc-actions">
        {project.preview && (
          <a class="pc-action" href={project.preview} target="_blank" rel="noopener noreferrer">
            <Icons.EyeIcon /> Ver proyecto
          </a>
        )}
        {project.href && (
          <a class="pc-action" href={project.href} target="_blank" rel="noopener noreferrer">
            <Icons.GitHubIcon class="size-3.5" /> GitHub
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
    padding: 0.8rem;
    border: 1px solid color-mix(in oklab, var(--project-accent) 20%, rgba(124, 249, 255, 0.1));
    border-radius: 0.65rem;
    background: linear-gradient(155deg, rgba(10, 17, 34, 0.9), rgba(5, 9, 20, 0.86));
    cursor: pointer;
    transition:
      transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 320ms ease,
      box-shadow 320ms ease,
      opacity 320ms ease,
      filter 320ms ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--project-accent) 40%, transparent);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.32);
  }

  .project-card[data-dimmed] {
    opacity: 0.45;
    filter: saturate(0.7);
    transform: scale(0.99);
  }

  .project-card[data-dimmed]:hover {
    opacity: 0.62;
    transform: scale(0.995);
  }

  .project-card.is-expanded {
    grid-column: 1 / -1;
    border-color: color-mix(in oklab, var(--project-accent) 50%, transparent);
  }

  .pc-top {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    min-width: 0;
  }

  .pc-thumb {
    flex: 0 0 4.4rem;
    width: 4.4rem;
    height: 3.3rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.03);
  }

  .pc-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.9) brightness(0.92);
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-card:hover .pc-thumb img { transform: scale(1.06); }

  .pc-heading { min-width: 0; flex: 1 1 auto; }

  .pc-status {
    color: var(--project-accent);
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .pc-heading h3 {
    margin-top: 0.16rem;
    color: #f2f7ff;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .pc-path {
    margin-top: 0.12rem;
    color: rgba(214, 226, 255, 0.4);
    font-size: 0.52rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pc-index {
    margin-left: auto;
    color: rgba(214, 226, 255, 0.32);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
  }

  .pc-desc {
    margin: 0;
    color: rgba(214, 226, 255, 0.68);
    font-size: 0.68rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
  }

  .pc-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.24rem 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.03);
    color: rgba(230, 241, 255, 0.78);
    font-size: 0.53rem;
  }

  .pc-tag :global(svg) { color: var(--project-accent); }

  .pc-more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--project-accent);
    font-family: 'Fira Code', ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .pc-more:hover { color: #fff; }

  .pc-more-mark { opacity: 0.75; }

  .pc-more:focus-visible {
    outline: 2px solid var(--project-accent);
    outline-offset: 4px;
    border-radius: 0.2rem;
  }

  .pc-details {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 300ms ease;
  }

  .pc-details-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .pc-kicker {
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(124, 249, 255, 0.55);
    font-size: 0.52rem;
    letter-spacing: 0.05em;
  }

  .pc-highlights {
    display: grid;
    gap: 0.3rem;
  }

  .pc-highlights li {
    position: relative;
    padding-left: 0.9rem;
    color: rgba(214, 226, 255, 0.76);
    font-size: 0.66rem;
    line-height: 1.5;
  }

  .pc-highlights li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--project-accent);
    font-weight: 700;
  }

  .pc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .pc-meta div { display: flex; flex-direction: column; gap: 0.12rem; }

  .pc-meta dt {
    color: rgba(214, 226, 255, 0.4);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pc-meta dd { color: #e6f1ff; font-size: 0.66rem; }

  .pc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pc-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.58rem;
    border: 1px solid color-mix(in oklab, var(--project-accent) 40%, transparent);
    border-radius: 0.4rem;
    background: color-mix(in oklab, var(--project-accent) 8%, transparent);
    color: var(--project-accent);
    font-size: 0.6rem;
    transition: background 220ms ease, border-color 220ms ease, transform 220ms ease;
  }

  .pc-action:hover {
    background: color-mix(in oklab, var(--project-accent) 14%, transparent);
    border-color: color-mix(in oklab, var(--project-accent) 65%, transparent);
    transform: translateY(-1px);
  }

  .pc-action :global(svg) { width: 0.85rem; height: 0.85rem; }

  .project-card.is-expanded .pc-desc {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .project-card.is-expanded .pc-details {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .pc-featured .pc-thumb { flex-basis: 4.8rem; width: 4.8rem; height: 3.6rem; }

  @media (min-width: 640px) {
    .pc-heading h3 { font-size: 0.98rem; }
    .pc-desc { font-size: 0.7rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .pc-thumb img,
    .pc-more,
    .pc-action,
    .pc-details {
      transition: none !important;
    }
    .project-card:hover,
    .project-card[data-dimmed],
    .project-card[data-dimmed]:hover,
    .pc-action:hover { transform: none; }
  }
</style>
