---
import * as Icons from './icons/index.js';
---

<section id="sobre-mi" class="about-layout">
  <div class="about-copy stagger-item" style="transition-delay:80ms;">
    <p class="about-eyebrow">Ingeniería · Desarrollo · Automatización</p>
    <h3>Conecto tecnología, datos e inteligencia artificial para resolver problemas reales.</h3>
    <p class="about-intro">
      Soy <strong>ingeniero en informática y desarrollador full stack</strong>, con experiencia en desarrollo web, integración de modelos de IA, agentes de voz y automatización de procesos comerciales. Combino criterio técnico y visión de negocio para crear herramientas que simplifican operaciones y ayudan a los equipos a crecer.
    </p>

    <div class="about-focus-grid" aria-label="Áreas de experiencia">
      <article class="about-focus-card" style="--focus-accent:#7cf9ff;">
        <span class="about-focus-icon"><Icons.CodeIcon /></span>
        <div><h4>Desarrollo full stack</h4><p>Aplicaciones SaaS, sitios web e integración de APIs REST.</p></div>
      </article>
      <article class="about-focus-card" style="--focus-accent:#a78bfa;">
        <span class="about-focus-icon"><Icons.OpenCodeIcon /></span>
        <div><h4>IA y automatización</h4><p>LLM, agentes de voz y flujos para Growth &amp; Sales.</p></div>
      </article>
      <article class="about-focus-card" style="--focus-accent:#34d399;">
        <span class="about-focus-icon"><Icons.DockerIcon /></span>
        <div><h4>Infraestructura y datos</h4><p>Linux, Proxmox VE, Docker, Supabase y Authentik.</p></div>
      </article>
      <article class="about-focus-card" style="--focus-accent:#fbbf24;">
        <span class="about-focus-icon"><Icons.MetaIcon /></span>
        <div><h4>Integraciones comerciales</h4><p>Meta CAPI, Leads API y sistemas CRM.</p></div>
      </article>
    </div>

    <div class="about-education">
      <span class="about-education-mark">2021—2026</span>
      <p><strong>Ingeniería en Informática</strong><span>Universidad Rafael Belloso Chacín</span></p>
    </div>

    <a href={`${import.meta.env.BASE_URL}cv-gustavo-vidal.pdf`} download="cv-gustavo-vidal.pdf" class="about-cv glow-border">
      <Icons.DownloadIcon />
      <span>Descargar CV</span>
      <span class="about-cv-arrow" aria-hidden="true">↗</span>
    </a>
  </div>

  <aside class="about-aside stagger-item" style="transition-delay:160ms;">
    <div class="about-terminal">
      <div class="about-terminal-bar">
        <span class="about-window-dots"><i></i><i></i><i></i></span>
        <span>tavo@profile:~</span>
        <span class="about-terminal-live">ONLINE</span>
      </div>
      <div class="about-photo-frame">
        <img src={`${import.meta.env.BASE_URL}icon (3).png`} alt="Gustavo Vidal" loading="lazy" />
      </div>
      <div class="about-terminal-caption"><span>MARACAIBO, VENEZUELA</span><span>ING. INFORMÁTICA</span></div>
    </div>
  </aside>
</section>

<style>
  .about-layout { display:grid; grid-template-columns:minmax(0,1fr); gap:1.5rem; align-items:start; }
  .about-copy { min-width:0; }
  .about-eyebrow { color:#7cf9ff; font:600 .62rem 'Fira Code',monospace; letter-spacing:.12em; text-transform:uppercase; }
  .about-copy h3 { margin-top:.7rem; color:#f5f9ff; font-size:clamp(1.35rem,3.2vw,2rem); line-height:1.2; font-weight:750; letter-spacing:-.035em; }
  .about-intro { margin-top:.8rem; color:rgba(214,226,255,.74); font-size:.86rem; line-height:1.7; }
  .about-intro strong { color:#f2f7ff; font-weight:650; }
  .about-focus-grid { display:grid; grid-template-columns:1fr; gap:.55rem; margin-top:1.1rem; }
  .about-focus-card { display:flex; align-items:flex-start; gap:.7rem; padding:.72rem; border:1px solid rgba(255,255,255,.08); border-left:2px solid var(--focus-accent); border-radius:.7rem; background:rgba(255,255,255,.025); transition:background 220ms ease,transform 220ms ease,border-color 220ms ease; }
  .about-focus-card:hover { transform:translateY(-2px); background:rgba(255,255,255,.05); border-color:color-mix(in oklab,var(--focus-accent) 28%,transparent); }
  .about-focus-icon { display:grid; place-items:center; flex:0 0 1.85rem; width:1.85rem; height:1.85rem; border-radius:.5rem; background:color-mix(in oklab,var(--focus-accent) 10%,transparent); color:var(--focus-accent); }
  .about-focus-icon :global(svg) { width:1rem; height:1rem; }
  .about-focus-card h4 { color:#edf4ff; font-size:.76rem; font-weight:650; }
  .about-focus-card p { margin-top:.15rem; color:rgba(214,226,255,.56); font-size:.67rem; line-height:1.45; }
  .about-education { display:flex; align-items:center; gap:.7rem; margin-top:1rem; padding:.7rem .75rem; border:1px solid rgba(124,249,255,.13); border-radius:.65rem; background:rgba(124,249,255,.025); }
  .about-education-mark { flex-shrink:0; color:#7cf9ff; font:600 .6rem 'Fira Code',monospace; }
  .about-education p { display:flex; flex-direction:column; gap:.12rem; color:#edf4ff; font-size:.71rem; }
  .about-education p span { color:rgba(214,226,255,.53); font-size:.65rem; }
  .about-cv { display:inline-flex; align-items:center; gap:.55rem; margin-top:1rem; padding:.58rem .8rem; border:1px solid rgba(124,249,255,.3); border-radius:.6rem; background:rgba(124,249,255,.055); color:#c8fbff; font-size:.72rem; font-weight:650; transition:background 220ms ease,border-color 220ms ease,transform 220ms ease; }
  .about-cv:hover { transform:translateY(-2px); background:rgba(124,249,255,.1); border-color:rgba(124,249,255,.58); }
  .about-cv :global(svg) { width:1rem; height:1rem; }
  .about-cv-arrow { margin-left:.35rem; color:rgba(124,249,255,.65); }
  .about-aside { display:flex; flex-direction:column; gap:.8rem; width:100%; max-width:350px; margin-inline:auto; }
  .about-terminal { overflow:hidden; border:1px solid rgba(120,210,255,.2); border-radius:.85rem; background:rgba(6,12,26,.82); box-shadow:0 18px 46px rgba(0,0,0,.28); }
  .about-terminal-bar { display:flex; align-items:center; gap:.6rem; padding:.62rem .75rem; border-bottom:1px solid rgba(120,210,255,.1); color:rgba(214,226,255,.58); font:500 .6rem 'Fira Code',monospace; }
  .about-window-dots { display:flex; gap:.25rem; }
  .about-window-dots i { width:.43rem; height:.43rem; border-radius:50%; background:#ff5f57; }
  .about-window-dots i:nth-child(2) { background:#febc2e; }.about-window-dots i:nth-child(3) { background:#28c840; }
  .about-terminal-live { margin-left:auto; color:#34d399; font-size:.52rem; }
  .about-photo-frame { aspect-ratio:1.15/1; overflow:hidden; background:radial-gradient(circle at 50% 40%,rgba(124,249,255,.1),transparent 70%),#0b1224; }
  .about-photo-frame img { width:100%; height:100%; object-fit:cover; object-position:center 35%; transition:transform 500ms ease; }
  .about-terminal:hover .about-photo-frame img { transform:scale(1.035); }
  .about-terminal-caption { display:flex; justify-content:space-between; gap:.5rem; padding:.55rem .7rem; color:rgba(214,226,255,.46); font:500 .52rem 'Fira Code',monospace; letter-spacing:.04em; }
  .about-stack-card { padding:.8rem; border-radius:.75rem; }
  .about-stack-label { margin-bottom:.6rem; color:rgba(124,249,255,.72); font:600 .58rem 'Fira Code',monospace; }
  .about-stack { display:flex; flex-wrap:wrap; gap:.35rem; }
  .about-stack span { display:inline-flex; align-items:center; gap:.32rem; padding:.34rem .45rem; border:1px solid rgba(255,255,255,.08); border-radius:.42rem; color:rgba(230,241,255,.72); font:500 .57rem 'Fira Code',monospace; }
  .about-stack :global(svg) { width:.78rem; height:.78rem; color:#7cf9ff; }
  @media (min-width:560px) { .about-focus-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (min-width:768px) { .about-layout { grid-template-columns:minmax(0,1.55fr) minmax(220px,.75fr); gap:1.5rem; } .about-aside { position:sticky; top:1.5rem; max-width:300px; } }
  @media (min-width:1024px) { .about-layout { grid-template-columns:minmax(0,1.7fr) minmax(260px,.8fr); gap:2rem; } .about-aside { max-width:330px; } .about-focus-grid { gap:.65rem; } }
</style>
